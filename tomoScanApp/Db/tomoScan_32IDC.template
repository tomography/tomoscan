# Database for EPICS PVS for tomography data collection software at APS 32-ID-C
# It contains the PVs that are required by the tomoscan_32idc derived class,
# as well as additional PVs used for metadata about the scan that are stored
# both in the configuration files written by tomoscan, and in the
# files written by areaDetector file plugin.
#
# This is a copy of tomoScan_2BM.template with the fast shutter records
# removed: the 32-ID-C Micro-CT station has no fast shutter.  Beam is admitted
# to the station by the 32-ID-B shutter (32idb:rshtrB:), which is handled by
# the OPEN_SHUTTER/CLOSE_SHUTTER macros in tomoScan.template.

#########################
# Beam status information
#########################

record(stringout, "$(P)$(R)BeamReadyPVName")
{
   field(VAL,  "$(BEAM_READY)")
}

record(stringout, "$(P)$(R)BeamReadyValue")
{
   field(VAL,  "$(READY_VALUE)")
}

record(bo, "$(P)$(R)Testing")
{
   field(ZNAM, "No")
   field(ONAM, "Yes")
}

